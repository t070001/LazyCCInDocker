{
  "name": "Claude Code Ubuntu 24.04 LTS",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "eamodio.gitlens"
      ]
    }
  },
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && sh ./setup-claude.sh"
}

